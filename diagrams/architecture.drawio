tyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" parent="1" source="d4" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;" edge="1" parent="1" source="d5" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="<b>Why this shape matters</b><br>Projects 2 and 3 are just two more jobs entering through the same runner.<br>The health check job needed no dashboard code at all: it runs through the runner,<br>so it appeared on /admin/crons automatically.<br><br>The web layer never runs a program. The rerun button writes a row; a trusted<br>worker with a fixed allowlist picks it up." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="490" width="960" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>